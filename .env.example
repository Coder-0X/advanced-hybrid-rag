# ==============================================================================
# Advanced Hybrid RAG Engine Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Storage & Vector Database
# Set to 'false' to persist index to disk at data/qdrant_db/
USE_IN_MEMORY_DB=true
QDRANT_COLLECTION=rag_documents

# Machine Learning & Transformer Models
# SentenceTransformers dense embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Deep Cross-Encoder reranker model
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Information Retrieval Hyperparameters
DENSE_TOP_K=10
SPARSE_TOP_K=10
RRF_K=60
DENSE_WEIGHT=0.5
SPARSE_WEIGHT=0.5
FINAL_TOP_K=5

# Document Chunking Hyperparameters
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Optional External Grounding LLM Providers (Leave blank for offline extractive synthesis)
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=AIzaSy...
